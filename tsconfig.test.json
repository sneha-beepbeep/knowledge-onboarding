{
  // Tests (run inside the Workers runtime by @cloudflare/vitest-pool-workers)
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "esnext.disposable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["test", "worker", "shared", "worker-configuration.d.ts"]
}
