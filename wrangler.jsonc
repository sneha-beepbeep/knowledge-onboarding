{
  // Cloudflare config: one Worker serves the React app (static assets) and the /api routes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onboarding-knowledge-check",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Requests that aren't /api/* fall through to the React app (client-side routing).
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onboarding-knowledge-check-db",
      // Placeholder — fine for local dev. Before first deploy, run
      // `npx wrangler d1 create onboarding-knowledge-check-db --location weur`
      // (EU, technical plan §10) and paste the real id here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Background AI drafting (technical plan §4, decision 4).
  "workflows": [
    { "name": "draft-topic", "binding": "DRAFT_WORKFLOW", "class_name": "DraftTopicWorkflow" }
  ],
  "vars": {
    // "local" enables AI_MOCK (from .dev.vars). Production must stay "production".
    "ENVIRONMENT": "production",
    // Model used for drafting (technical plan §4). Sonnet is a one-line switch: "claude-sonnet-5-5".
    "AI_MODEL": "claude-opus-5-5",
    // Company time is fixed GMT+2 all year, no daylight saving (CPO, 2026-09-29).
    // IANA "Etc/GMT-2" means UTC+2: the Etc/ sign is inverted on purpose.
    "APP_TIMEZONE": "Etc/GMT-2",
    // Round 1 runs without AI (CPO, 2026-09-29): drafting is off, questions are loaded
    // with scripts/import-questions.mjs, and "AI provider set up" doesn't block Form A.
    // Only "false" turns AI off; unset means on. Not inherited by env.demo (mock stays on).
    "AI_ENABLED": "false"
  },
  "observability": { "enabled": true },

  "env": {
    // DEMO COPY — never the pilot (CPO, 2026-09-29). Its own worker, D1 database and
    // Workflow, so demo data never reaches the pilot DB or its M3 figures.
    // Deploy with `npm run deploy:demo` only. In a wrangler environment, vars, D1 and
    // workflows are NOT inherited from the top level, so every one is repeated here.
    "demo": {
      "name": "knowledge-check-demo",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "knowledge-check-demo-db",
          // Written by `npm run deploy:demo` (creates the DB in weur, or reuses it).
          "database_id": "00000000-0000-0000-0000-0000000000de",
          "migrations_dir": "migrations"
        }
      ],
      "workflows": [
        { "name": "knowledge-check-demo-draft-topic", "binding": "DRAFT_WORKFLOW", "class_name": "DraftTopicWorkflow" }
      ],
      "vars": {
        // "demo" permits AI_MOCK (canned drafts quoted from the uploaded text, no AI call).
        "ENVIRONMENT": "demo",
        "AI_MOCK": "1",
        "AI_MODEL": "claude-opus-5-5",
        "APP_TIMEZONE": "Etc/GMT-2"
      }
    }
  }
}
